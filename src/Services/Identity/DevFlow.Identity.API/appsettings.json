{
  "ConnectionStrings": {
    "IdentityDatabase": "Host=localhost;Port=5432;Database=devflow_identity;Username=postgres;Password=postgres",
    "DefaultConnection": ""
  },

  "Jwt": {
    "Issuer": "DevFlow",
    "Audience": "DevFlow",
    "SecretKey": "your-very-long-secret-key-at-least-32-characters",
    "ExpirationMinutes": 60
  },

  "Logging": {
    "LogLevel": {
      "Default": "Information"
    }
  },
  "Mfa": {
    "Issuer": "DevFlow",
    "SecretLength": 20,
    "RecoveryCodeCount": 10
  },
  "Lockout": {
    "MaxFailedAttempts": 5,
    "DurationMinutes": 15
  }
}
